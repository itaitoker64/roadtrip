NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Light gating: shared PIN the whole family uses to unlock collaborative editing
NEXT_PUBLIC_TRIP_PIN=2026
